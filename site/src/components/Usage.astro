---
const commands = [
  {
    cmd: 'ax agent new',
    flags: [
      { flag: '-a claude|codex|gemini|opencode', desc: 'Choose which AI agent to launch' },
      { flag: '-n <name>', desc: 'Give this session a memorable name' },
      { flag: '-- <args...>', desc: 'Pass extra arguments to the agent binary' },
    ],
    example: 'ax agent new -a claude -n refactor-auth',
    desc: 'Spawn a new agent in an isolated git worktree on branch ax/<id>.',
    color: 'blue',
  },
  {
    cmd: 'ax agent resume',
    flags: [
      { flag: '-n <id|name>', desc: 'Agent ID or name to resume' },
      { flag: '-a <agent>', desc: 'Override agent type for this session' },
    ],
    example: 'ax agent resume -n refactor-auth',
    desc: 'Reattach to a previous session in the same worktree.',
    color: 'cyan',
  },
  {
    cmd: 'ax agent diff',
    flags: [
      { flag: '-n <id|name>', desc: 'Which agent\'s commits to diff' },
    ],
    example: 'ax agent diff -n refactor-auth',
    desc: 'Pipe all agent commits through your $PAGER for review.',
    color: 'purple',
  },
  {
    cmd: 'ax agent cd',
    flags: [
      { flag: '-n <id|name>', desc: 'Open a shell in this agent\'s worktree' },
    ],
    example: 'ax agent cd -n refactor-auth',
    desc: 'Jump into the worktree directory to inspect or run tests.',
    color: 'green',
  },
  {
    cmd: 'ax agent list',
    flags: [],
    example: 'ax agent list',
    desc: 'Print all agents with their ID, name, status, repo, and directory.',
    color: 'yellow',
  },
  {
    cmd: 'ax agent remove',
    flags: [
      { flag: '-n <id|name>', desc: 'Agent to remove (must be finished)' },
    ],
    example: 'ax agent remove -n refactor-auth',
    desc: 'Clean up the worktree, log file, and state entry.',
    color: 'orange',
  },
  {
    cmd: 'ax dash',
    flags: [],
    example: 'ax dash',
    desc: 'Open the interactive TUI dashboard with live agent status.',
    color: 'teal',
  },
];

const keybindings = [
  { key: 'j / ↓', action: 'Move down', view: 'List' },
  { key: 'k / ↑', action: 'Move up', view: 'List' },
  { key: 'Enter', action: 'View agent logs', view: 'List' },
  { key: 'o', action: 'Toggle finished agents', view: 'List' },
  { key: '/', action: 'Search agents', view: 'List' },
  { key: 'y', action: 'Copy cd command', view: 'List' },
  { key: 'K', action: 'Kill selected agent', view: 'List' },
  { key: 'q / Ctrl+C', action: 'Quit', view: 'Both' },
  { key: 'Esc / q', action: 'Back to list', view: 'Detail' },
];
---
<section id="usage" class="usage-section">
  <div class="section-inner">
    <div class="section-header">
      <span class="section-tag">Usage</span>
      <h2 class="section-title">CLI <span class="gradient-text">reference</span></h2>
      <p class="section-desc">
        All commands follow a simple, consistent pattern.
        Every session is tracked and resumable.
      </p>
    </div>

    <div class="commands-list">
      {commands.map((c) => (
        <div class={`cmd-card cmd-card--${c.color}`}>
          <div class="cmd-header">
            <code class="cmd-name">{c.cmd}</code>
            <span class="cmd-desc">{c.desc}</span>
          </div>
          {c.flags.length > 0 && (
            <div class="cmd-flags">
              {c.flags.map((f) => (
                <div class="flag">
                  <code class="flag-name">{f.flag}</code>
                  <span class="flag-desc">{f.desc}</span>
                </div>
              ))}
            </div>
          )}
          <div class="cmd-example">
            <span class="example-prompt">$</span>
            <code class="example-cmd">{c.example}</code>
          </div>
        </div>
      ))}
    </div>

    <div class="keybindings">
      <h3 class="kb-title">
        <span>Dashboard Keybindings</span>
        <code class="kb-cmd">ax dash</code>
      </h3>
      <div class="kb-table">
        <div class="kb-header">
          <span>Key</span>
          <span>Action</span>
          <span>View</span>
        </div>
        {keybindings.map((kb) => (
          <div class="kb-row">
            <code class="kb-key">{kb.key}</code>
            <span class="kb-action">{kb.action}</span>
            <span class="kb-view">{kb.view}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .usage-section {
    padding: 6rem 2rem;
    background: var(--tn-bg);
  }

  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tn-purple);
    background: rgba(187, 154, 247, 0.1);
    border: 1px solid rgba(187, 154, 247, 0.2);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--tn-fg);
    margin-bottom: 1rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--tn-purple) 0%, var(--tn-blue) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--tn-fg-dark);
    max-width: 440px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .commands-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .cmd-card {
    background: var(--tn-bg-card);
    border: 1px solid var(--tn-border);
    border-radius: 10px;
    padding: 1.25rem;
    transition: border-color 0.2s;
  }

  .cmd-card--blue:hover   { border-color: var(--tn-blue); }
  .cmd-card--cyan:hover   { border-color: var(--tn-cyan); }
  .cmd-card--purple:hover { border-color: var(--tn-purple); }
  .cmd-card--green:hover  { border-color: var(--tn-green); }
  .cmd-card--yellow:hover { border-color: var(--tn-yellow); }
  .cmd-card--orange:hover { border-color: var(--tn-orange); }
  .cmd-card--teal:hover   { border-color: var(--tn-teal); }

  .cmd-header {
    margin-bottom: 0.9rem;
  }

  .cmd-name {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--tn-cyan);
    font-family: 'JetBrains Mono', monospace;
    margin-bottom: 0.4rem;
  }

  .cmd-desc {
    display: block;
    font-size: 0.85rem;
    color: var(--tn-fg-dark);
    line-height: 1.5;
  }

  .cmd-flags {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 0.9rem;
    padding: 0.6rem 0.75rem;
    background: var(--tn-bg-dark);
    border-radius: 6px;
    border: 1px solid var(--tn-border);
  }

  .flag {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .flag-name {
    font-size: 0.75rem;
    color: var(--tn-yellow);
    font-family: 'JetBrains Mono', monospace;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .flag-desc {
    font-size: 0.78rem;
    color: var(--tn-comment);
  }

  .cmd-example {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--tn-bg-dark);
    padding: 0.6rem 0.75rem;
    border-radius: 6px;
    border: 1px solid var(--tn-border);
  }

  .example-prompt {
    color: var(--tn-comment);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.82rem;
    user-select: none;
  }

  .example-cmd {
    font-size: 0.82rem;
    color: var(--tn-green);
    font-family: 'JetBrains Mono', monospace;
  }

  .keybindings {
    background: var(--tn-bg-card);
    border: 1px solid var(--tn-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .kb-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--tn-border);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--tn-fg);
  }

  .kb-cmd {
    font-size: 0.78rem;
    color: var(--tn-cyan);
    font-family: 'JetBrains Mono', monospace;
    background: rgba(125, 207, 255, 0.1);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .kb-table {
    display: grid;
  }

  .kb-header {
    display: grid;
    grid-template-columns: 160px 1fr 80px;
    gap: 1rem;
    padding: 0.6rem 1.5rem;
    background: var(--tn-bg-dark);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--tn-comment);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .kb-row {
    display: grid;
    grid-template-columns: 160px 1fr 80px;
    gap: 1rem;
    padding: 0.65rem 1.5rem;
    border-top: 1px solid rgba(45, 49, 88, 0.5);
    align-items: center;
    transition: background 0.15s;
  }

  .kb-row:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .kb-key {
    font-size: 0.8rem;
    color: var(--tn-yellow);
    font-family: 'JetBrains Mono', monospace;
  }

  .kb-action {
    font-size: 0.85rem;
    color: var(--tn-fg-dark);
  }

  .kb-view {
    font-size: 0.75rem;
    color: var(--tn-comment);
    text-align: right;
  }

  @media (max-width: 768px) {
    .commands-list { grid-template-columns: 1fr; }
    .kb-header { grid-template-columns: 140px 1fr; }
    .kb-row    { grid-template-columns: 140px 1fr; }
    .kb-view   { display: none; }
  }
</style>
