---
const base = import.meta.env.BASE_URL;
---
<nav class="nav">
  <div class="nav-inner">
    <a href={base} class="nav-brand">
      <span class="brand-name">agx - Manage Multi AI Agents with Parallel Git Worktrees</span>
    </a>
    <ul class="nav-links">
      <li><a href="#features">Features</a></li>
      <li><a href="#install">Install</a></li>
      <li>
        <a href="https://github.com/jedipunkz/agx" class="nav-github" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgb(30 30 46 / 82%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgb(49 50 68 / 72%);
  }

  .nav-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    margin-right: 1rem;
    color: var(--tn-fg);
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: 0;
  }
  .nav-brand:hover { color: var(--tn-blue); }

  .brand-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: 'SF Mono', ui-monospace, Menlo, Monaco, Consolas, monospace;
    color: var(--tn-fg-strong);
  }

  @media (max-width: 860px) {
    .nav-brand {
      font-size: 0.82rem;
    }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
  }

  .nav-links a {
    color: var(--tn-fg-dark);
    font-size: 0.9rem;
    padding: 0.48rem 0.78rem;
    border-radius: 6px;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }
  .nav-links a:hover {
    color: var(--tn-cyan);
    background: rgb(137 180 250 / 10%);
  }

  .nav-github {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgb(49 50 68 / 88%) !important;
    border: 1px solid rgb(137 180 250 / 24%) !important;
    color: var(--tn-fg-strong) !important;
    padding: 0.48rem 0.9rem !important;
    box-shadow: var(--tn-ring);
  }
  .nav-github:hover {
    border-color: rgb(137 220 235 / 52%) !important;
    color: var(--tn-cyan) !important;
    background: rgb(69 71 90 / 92%) !important;
  }

  @media (max-width: 640px) {
    .nav-inner {
      padding: 0 1.25rem;
    }

    .nav-links li:not(:last-child) {
      display: none;
    }
  }
</style>
