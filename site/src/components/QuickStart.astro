---
const steps = [
  {
    label: '1. Start in a repo',
    cmd: 'cd /path/to/repo && ax agent new',
    desc: 'ax detects the current git repository and creates an isolated worktree for the new agent.',
  },
  {
    label: '2. Pick an agent',
    cmd: 'ax agent new -a codex -n feat/foo',
    desc: 'Claude Code is the default; use -a for Codex, Gemini, or OpenCode and -n to name the branch.',
  },
  {
    label: '3. Watch the work',
    cmd: 'ax dash',
    desc: 'Open the dashboard to inspect status, search sessions, copy worktree paths, and kill stuck agents.',
  },
  {
    label: '4. Follow logs',
    cmd: 'ax agent logs -f -n <name|id>',
    desc: 'Stream agent output from any terminal, or omit -f to dump the full stripped log.',
  },
  {
    label: '5. Wait or answer',
    cmd: 'ax agent wait -n <name|id>',
    desc: 'Block scripts until a session exits or pauses, then use ax agent input when it is waiting.',
  },
  {
    label: '6. Resume or clean up',
    cmd: 'ax agent resume -n feat/foo',
    desc: 'Resume previous sessions, cd into their worktrees, list them, or remove finished work when done.',
  },
];
---
<section class="quickstart-section" aria-label="Quick start">
  <div class="section-inner">
    <div class="section-header">
      <p class="section-tag">Quick start</p>
      <h2>Run, inspect, resume, and clean up agents.</h2>
    </div>

    <div class="steps-grid">
      {steps.map((step) => (
        <article class="step-card">
          <p class="step-label">{step.label}</p>
          <code>{step.cmd}</code>
          <p>{step.desc}</p>
        </article>
      ))}
    </div>

    <p class="state-note">
      Session state, logs, and worktrees live under <code>~/.ax/</code>.
      Configure dashboard themes, finished-session retention, and automatic worktree cleanup in <code>~/.ax/ax.yaml</code>.
    </p>
  </div>
</section>

<style>
  .quickstart-section {
    padding: 4.75rem 2rem 5.5rem;
    border-top: 1px solid rgb(59 66 97 / 72%);
    background: var(--tn-bg-soft);
  }

  .section-inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .section-header {
    max-width: 700px;
    margin-bottom: 1.35rem;
  }

  .section-tag {
    color: var(--tn-orange);
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  h2 {
    color: var(--tn-fg-strong);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 720;
    letter-spacing: 0;
    line-height: 1.05;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.05rem;
  }

  .step-card {
    min-height: 220px;
    padding: 22px;
    border: 1px solid rgb(59 66 97 / 78%);
    border-radius: 8px;
    background: rgb(36 40 59 / 86%);
    box-shadow: var(--tn-shadow);
  }

  .step-label {
    color: var(--tn-blue);
    font-size: 0.85rem;
    font-weight: 800;
    margin-bottom: 14px;
  }

  .step-card code {
    display: block;
    color: var(--tn-green);
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.55;
    overflow-wrap: anywhere;
    margin-bottom: 14px;
    padding: 10px 12px;
    border: 1px solid rgb(86 95 137 / 54%);
    border-radius: 6px;
    background: rgb(22 22 30 / 58%);
  }

  .step-card p:last-child,
  .state-note {
    color: var(--tn-fg-dark);
    font-size: 1rem;
    line-height: 1.6;
  }

  .state-note {
    max-width: 720px;
    margin-top: 1.4rem;
    padding-left: 14px;
    border-left: 2px solid var(--tn-blue);
  }

  .state-note code {
    color: var(--tn-green);
    font-weight: 800;
  }

  @media (max-width: 860px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .quickstart-section {
      padding: 3.5rem 1.25rem 4rem;
    }
  }
</style>
