---
const base = import.meta.env.BASE_URL;
---
<footer class="footer">
  <div class="footer-inner">
    <a href={base} class="brand-link">
      <span class="brand-name">ax - agent cross</span>
    </a>
    <div class="footer-links">
      <a href="https://github.com/jedipunkz/ax" target="_blank" rel="noopener">GitHub</a>
      <a href="https://github.com/jedipunkz/ax/releases" target="_blank" rel="noopener">Releases</a>
      <a href="https://github.com/jedipunkz/ax/issues" target="_blank" rel="noopener">Issues</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--tn-border);
    background: var(--tn-bg);
    padding: 1.5rem 2rem;
  }

  .footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    color: var(--tn-fg);
    font-weight: 700;
  }

  .brand-name {
    color: var(--tn-blue);
    font-family: 'SF Mono', ui-monospace, Menlo, Monaco, Consolas, monospace;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1rem;
  }

  .footer-links a {
    color: var(--tn-comment);
    font-size: 0.9rem;
  }

  .footer-links a:hover {
    color: var(--tn-blue);
  }

  @media (max-width: 560px) {
    .footer {
      padding: 1.25rem;
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-links {
      justify-content: flex-start;
    }
  }
</style>
