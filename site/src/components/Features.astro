---
const features = [
  {
    label: 'Worktrees',
    title: 'Isolated work',
    desc: 'Each agent runs in its own git worktree and branch.',
  },
  {
    label: 'Parallel',
    title: 'Parallel sessions',
    desc: 'Launch multiple agents for the same task and compare results.',
  },
  {
    label: 'Review',
    title: 'Simple review',
    desc: 'List sessions, inspect diffs, resume work, and clean up from the CLI.',
  },
];
---
<section id="features" class="features-section">
  <div class="section-inner">
    <div class="section-header">
      <h2>Features</h2>
    </div>

    <div class="features-grid">
      {features.map((f) => (
        <article class="feature-card">
          <p class="feature-label">{f.label}</p>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 2rem 2rem 5.25rem;
    border-top: 1px solid var(--tn-border);
  }

  .section-inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  h2 {
    max-width: 620px;
    color: var(--tn-fg);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 720;
    letter-spacing: 0;
    line-height: 1.05;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .feature-card {
    min-height: 230px;
    padding: 24px;
    border: 1px solid var(--tn-border);
    border-radius: 8px;
    background: var(--tn-bg-card);
    box-shadow: var(--tn-shadow);
  }

  .feature-label {
    width: fit-content;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgb(34 50 73 / 92%);
    color: var(--tn-blue);
    font-size: 0.8rem;
    font-weight: 900;
    margin-bottom: 14px;
  }

  .feature-card h3 {
    color: var(--tn-fg);
    font-size: 1.45rem;
    line-height: 1.1;
    margin-bottom: 14px;
  }

  .feature-card p {
    color: var(--tn-fg-dark);
    font-size: 1rem;
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .features-section {
      padding: 1.5rem 1.25rem 3.25rem;
    }

    .section-header {
      display: block;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
