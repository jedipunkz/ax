---
---
<section id="install" class="install-section">
  <div class="section-inner">
    <div>
      <p class="section-tag">Install</p>
      <h2>One command to start.</h2>
      <p class="section-desc">Install ax with Homebrew.</p>
    </div>

    <div class="install-panel">
      <div class="code-row">
        <code>brew tap jedipunkz/ax && brew install ax</code>
        <button class="copy-btn" data-copy="brew tap jedipunkz/ax && brew install ax">Copy</button>
      </div>
    </div>
  </div>
</section>

<style>
  .install-section {
    padding: 4.5rem 2rem 6rem;
    border-top: 1px solid var(--tn-border);
  }

  .section-inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    gap: 1.5rem;
  }

  .section-tag {
    color: var(--tn-orange);
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  h2 {
    color: var(--tn-fg);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 720;
    letter-spacing: 0;
    line-height: 1.05;
    margin-bottom: 1rem;
    white-space: nowrap;
  }

  .section-desc {
    max-width: 360px;
    color: var(--tn-fg-dark);
    font-size: 1rem;
  }

  .install-panel {
    max-width: 720px;
    border: 1px solid var(--tn-border);
    border-radius: 8px;
    background: var(--tn-bg-card);
    overflow: hidden;
    box-shadow: var(--tn-shadow);
  }

  .code-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
  }

  .code-row code {
    color: var(--tn-green);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .copy-btn {
    min-height: 34px;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--tn-border-hi);
    border-radius: 6px;
    background: var(--tn-bg-hi);
    color: var(--tn-fg);
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
  }

  .copy-btn:hover,
  .copy-btn.copied {
    border-color: var(--tn-orange);
    color: var(--tn-orange);
  }

  @media (max-width: 760px) {
    .install-section {
      padding: 3.5rem 1.25rem 4rem;
    }

    .code-row {
      grid-template-columns: 1fr;
    }

    h2 {
      white-space: normal;
    }
  }
</style>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy');
      if (!text) return;

      navigator.clipboard.writeText(text).then(() => {
        btn.textContent = 'Copied';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('copied');
        }, 1600);
      });
    });
  });
</script>
