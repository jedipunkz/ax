---
const base = import.meta.env.BASE_URL;
---
<section class="hero">
  <div class="hero-content">
    <p class="eyebrow">agent cross</p>
    <div class="hero-title">
      <img src={`${base}icon.png`} alt="ax official icon" width="128" height="128" class="hero-icon" />
      <h1>ax</h1>
    </div>
    <p class="hero-desc">
      Run Claude Code, Codex CLI, Gemini CLI, and OpenCode in parallel git worktrees, then monitor, resume, inspect, and clean up every session from one terminal workflow.
    </p>

    <div class="hero-actions">
      <a href="#install" class="btn btn-primary">Install ax</a>
      <a href="https://github.com/jedipunkz/ax" class="btn btn-secondary" target="_blank" rel="noopener">GitHub</a>
    </div>

    <div class="quick-command" aria-label="Install command">
      <span class="prompt">$</span>
      <code>brew tap jedipunkz/ax && brew install ax</code>
    </div>
  </div>

  <figure class="hero-media">
    <img
      src="https://jedipunkz.rocks/pix/ax.png"
      alt="ax terminal dashboard showing multiple agent sessions"
      width="2988"
      height="1642"
      loading="eager"
      decoding="async"
    />
  </figure>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(760px, 90vh);
    max-width: 1180px;
    margin: 0 auto;
    padding: 8rem 2rem 4.75rem;
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(380px, 1fr);
    gap: 44px;
    align-items: center;
  }

  .hero-content {
    display: grid;
    gap: 26px;
    max-width: 780px;
  }

  .eyebrow {
    width: fit-content;
    padding: 5px 10px;
    border: 1px solid rgb(122 162 247 / 24%);
    border-radius: 999px;
    background: rgb(122 162 247 / 8%);
    color: var(--tn-cyan);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .hero-title {
    display: grid;
    grid-template-columns: auto minmax(0, auto);
    align-items: center;
    gap: clamp(18px, 3vw, 30px);
    width: fit-content;
    max-width: 100%;
    min-width: 0;
  }

  .hero-icon {
    display: block;
    width: clamp(82px, 13vw, 128px);
    height: clamp(82px, 13vw, 128px);
    flex: 0 0 auto;
    border: 1px solid rgb(122 162 247 / 20%);
    border-radius: 20px;
    box-shadow: var(--tn-shadow);
    transform: translateY(0.08em);
  }

  h1 {
    color: var(--tn-fg-strong);
    font-size: clamp(5.5rem, 15vw, 9.5rem);
    font-weight: 820;
    letter-spacing: 0;
    line-height: 0.88;
    max-width: 900px;
    margin: 0;
  }

  .hero-desc {
    max-width: 620px;
    color: var(--tn-fg-dark);
    font-size: clamp(1.18rem, 2.6vw, 1.45rem);
    line-height: 1.42;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease, color 0.18s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-primary {
    background: var(--tn-blue);
    border: 1px solid rgb(125 207 255 / 42%);
    color: var(--tn-bg-dark);
    box-shadow: 0 14px 28px rgb(122 162 247 / 18%);
  }

  .btn-primary:hover {
    color: var(--tn-bg-dark);
    background: var(--tn-cyan);
    border-color: var(--tn-cyan);
  }

  .btn-secondary {
    color: var(--tn-fg-strong);
    border: 1px solid rgb(187 154 247 / 44%);
    background: rgb(187 154 247 / 10%);
  }

  .btn-secondary:hover {
    color: var(--tn-purple);
    border-color: var(--tn-purple);
    background: rgb(187 154 247 / 16%);
  }

  .quick-command {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    gap: 0.7rem;
    width: min(100%, 520px);
    padding: 18px 20px;
    border: 1px solid rgb(86 95 137 / 74%);
    border-radius: 8px;
    background: rgb(22 22 30 / 72%);
    color: var(--tn-fg-dark);
    box-shadow: var(--tn-shadow);
  }

  .prompt {
    color: var(--tn-orange);
    font-family: 'SF Mono', ui-monospace, Menlo, Monaco, Consolas, monospace;
  }

  .quick-command code {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--tn-green);
    font-size: 1.02rem;
    font-weight: 800;
  }

  .hero-media {
    margin: 0;
    min-width: 0;
  }

  .hero-media img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgb(86 95 137 / 70%);
    border-radius: 8px;
    background: var(--tn-bg-card);
    box-shadow: var(--tn-shadow);
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 32px;
      min-height: auto;
    }

    .hero-media {
      max-width: 720px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding: 6.5rem 1.25rem 3rem;
    }

    .hero-title {
      gap: 14px;
    }

    .hero-icon {
      width: 74px;
      height: 74px;
      border-radius: 16px;
    }

    .quick-command {
      padding: 14px 16px;
    }
  }
</style>
