---
const base = import.meta.env.BASE_URL;
---
<section class="hero">
  <div class="hero-content">
    <div class="hero-title">
      <img src={`${base}icon.png`} alt="agx official icon" width="128" height="128" class="hero-icon" />
      <h1>agx</h1>
    </div>
    <p class="hero-desc">
      Run Claude Code, Codex CLI, Gemini CLI, and OpenCode in parallel git worktrees, then monitor, resume, inspect, and clean up every session from one terminal workflow.
    </p>

    <div class="hero-actions">
      <a href="#install" class="btn btn-primary">Install agx</a>
      <a href="https://github.com/jedipunkz/agx" class="btn btn-secondary" target="_blank" rel="noopener">GitHub</a>
    </div>

    <div class="quick-command" aria-label="Install command">
      <span class="prompt">$</span>
      <code><span class="sh-cmd">brew</span> <span class="sh-arg">tap jedipunkz/agx</span> <span class="sh-op">&amp;&amp;</span> <span class="sh-cmd">brew</span> <span class="sh-arg">install agx</span></code>
      <button type="button" class="quick-copy" data-copy="brew tap jedipunkz/agx && brew install agx" aria-label="Copy install command">Copy</button>
    </div>
  </div>

  <figure class="hero-media">
    <button type="button" class="hero-shot-trigger" aria-label="Enlarge dashboard screenshot">
      <img
        src="https://jedipunkz.rocks/pix/ax.png"
        alt="agx terminal dashboard showing multiple agent sessions"
        width="2988"
        height="1642"
        loading="eager"
        decoding="async"
      />
    </button>
  </figure>
</section>

<div class="lightbox" id="hero-lightbox" role="dialog" aria-modal="true" aria-label="Enlarged dashboard screenshot" hidden>
  <button type="button" class="lightbox-close" aria-label="Close">&times;</button>
  <img
    src="https://jedipunkz.rocks/pix/ax.png"
    alt="agx terminal dashboard showing multiple agent sessions"
    decoding="async"
  />
</div>

<style>
  .hero {
    position: relative;
    min-height: min(760px, 90vh);
    max-width: 1180px;
    margin: 0 auto;
    padding: 8rem 2rem 4.75rem;
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(380px, 1fr);
    gap: 44px;
    align-items: center;
  }

  .hero-content {
    display: grid;
    gap: 26px;
    max-width: 780px;
  }

  .hero-title {
    display: grid;
    grid-template-columns: auto minmax(0, auto);
    align-items: center;
    gap: clamp(14px, 2vw, 20px);
    width: fit-content;
    max-width: 100%;
    min-width: 0;
  }

  .hero-icon {
    display: block;
    width: clamp(56px, 8vw, 80px);
    height: clamp(56px, 8vw, 80px);
    flex: 0 0 auto;
    border: 1px solid rgb(137 180 250 / 20%);
    border-radius: 16px;
    box-shadow: var(--tn-shadow);
    transform: translateY(0.04em);
  }

  h1 {
    color: var(--tn-fg-strong);
    font-family: var(--tn-mono);
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.05;
    max-width: 900px;
    margin: 0;
  }

  .hero-desc {
    max-width: 620px;
    color: var(--tn-fg-dark);
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 7px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease, color 0.18s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-primary {
    background: var(--tn-blue);
    border: 1px solid rgb(137 220 235 / 42%);
    color: var(--tn-bg-dark);
    box-shadow: 0 14px 28px rgb(137 180 250 / 18%);
  }

  .btn-primary:hover {
    color: var(--tn-bg-dark);
    background: var(--tn-cyan);
    border-color: var(--tn-cyan);
  }

  .btn-secondary {
    color: var(--tn-fg-strong);
    border: 1px solid rgb(203 166 247 / 44%);
    background: rgb(203 166 247 / 10%);
  }

  .btn-secondary:hover {
    color: var(--tn-purple);
    border-color: var(--tn-purple);
    background: rgb(203 166 247 / 16%);
  }

  .quick-command {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    gap: 0.7rem;
    width: min(100%, 520px);
    padding: 18px 20px;
    border: 1px solid var(--tn-border);
    border-radius: 8px;
    background: var(--tn-bg-dark);
    color: var(--tn-fg-dark);
    box-shadow: var(--tn-shadow);
  }

  .prompt {
    color: var(--tn-orange);
    font-family: 'SF Mono', ui-monospace, Menlo, Monaco, Consolas, monospace;
  }

  .quick-command code {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--tn-blue);
    font-size: 1.02rem;
    font-weight: 800;
  }

  .quick-copy {
    flex: 0 0 auto;
    min-height: 30px;
    padding: 0.3rem 0.7rem;
    border: 1px solid rgb(137 180 250 / 30%);
    border-radius: 6px;
    background: rgb(69 71 90 / 60%);
    color: var(--tn-fg-strong);
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
  }

  .quick-copy:hover,
  .quick-copy.copied {
    border-color: var(--tn-cyan);
    color: var(--tn-cyan);
    background: rgb(137 180 250 / 12%);
  }

  .hero-media {
    margin: 0;
    min-width: 0;
  }

  .hero-shot-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: 8px;
  }

  .hero-shot-trigger:focus-visible {
    outline: 2px solid var(--tn-cyan);
    outline-offset: 4px;
  }

  .hero-media img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgb(69 71 90 / 70%);
    border-radius: 8px;
    background: var(--tn-bg-card);
    box-shadow: var(--tn-shadow);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .hero-shot-trigger:hover img {
    border-color: rgb(137 180 250 / 55%);
    transform: translateY(-2px);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vmin;
    background: rgb(17 17 27 / 90%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: zoom-out;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox img {
    max-width: min(1400px, 96vw);
    max-height: 92vh;
    width: auto;
    height: auto;
    border: 1px solid var(--tn-border);
    border-radius: 10px;
    box-shadow: var(--tn-shadow);
  }

  .lightbox-close {
    position: absolute;
    top: max(16px, 2vmin);
    right: max(16px, 2vmin);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--tn-border);
    border-radius: 8px;
    background: rgb(30 30 46 / 92%);
    color: var(--tn-fg-strong);
    font-size: 1.7rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.18s ease, color 0.18s ease;
  }

  .lightbox-close:hover {
    border-color: var(--tn-cyan);
    color: var(--tn-cyan);
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 32px;
      min-height: auto;
    }

    .hero-media {
      max-width: 720px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding: 6.5rem 1.25rem 3rem;
    }

    .hero-title {
      gap: 14px;
    }

    .hero-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
    }

    .quick-command {
      padding: 14px 16px;
    }
  }
</style>

<script>
  const lightbox = document.getElementById('hero-lightbox');
  const trigger = document.querySelector('.hero-shot-trigger');
  const closeBtn = lightbox?.querySelector('.lightbox-close');

  const open = () => {
    if (!lightbox) return;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    closeBtn instanceof HTMLElement && closeBtn.focus();
  };

  const close = () => {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = '';
    trigger instanceof HTMLElement && trigger.focus();
  };

  trigger?.addEventListener('click', open);
  lightbox?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.hidden) close();
  });

  const copyBtn = document.querySelector('.quick-copy');
  copyBtn?.addEventListener('click', () => {
    const text = copyBtn.getAttribute('data-copy');
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
      copyBtn.textContent = 'Copied';
      copyBtn.classList.add('copied');
      setTimeout(() => {
        copyBtn.textContent = 'Copy';
        copyBtn.classList.remove('copied');
      }, 1600);
    });
  });
</script>
