---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'ax is a CLI that runs Claude Code, Codex CLI, Gemini CLI, and OpenCode agents in parallel git worktrees, with a terminal dashboard to monitor, resume, and inspect every session.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(`${base}og.png`, Astro.site).toString();
const ogImageAlt = 'ax terminal dashboard managing multiple AI coding agents across parallel git worktrees';
const keywords =
  'ax, AI coding agent, AI agent orchestrator, Claude Code, Codex CLI, Gemini CLI, OpenCode, parallel agents, git worktree, terminal dashboard, CLI, developer tools, agent manager, coding agents';
const repoURL = 'https://github.com/jedipunkz/ax';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${canonicalURL}#software`,
      name: 'ax',
      description,
      url: canonicalURL,
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'CLI',
      operatingSystem: 'macOS, Linux',
      image: ogImageURL,
      screenshot: 'https://jedipunkz.rocks/pix/ax.png',
      downloadUrl: `${repoURL}/releases`,
      softwareHelp: repoURL,
      codeRepository: repoURL,
      keywords,
      featureList: [
        'Run Claude Code, Codex CLI, Gemini CLI, and OpenCode agents from one workflow',
        'Isolated git worktree and branch per agent session',
        'Terminal dashboard to monitor running, waiting, successful, failed, and killed agents',
        'Resume sessions, stream logs, and send input when an agent is waiting',
        'Automatic cleanup of finished worktrees',
      ],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@id': `${canonicalURL}#person` },
      publisher: { '@id': `${canonicalURL}#person` },
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalURL}#website`,
      name: 'ax',
      url: canonicalURL,
      description,
      inLanguage: 'en',
      publisher: { '@id': `${canonicalURL}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${canonicalURL}#person`,
      name: 'jedipunkz',
      url: 'https://github.com/jedipunkz',
      sameAs: ['https://github.com/jedipunkz'],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1e1e2e" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="jedipunkz" />
    <meta name="application-name" content="ax" />
    <meta name="apple-mobile-web-app-title" content="ax" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://jedipunkz.rocks" crossorigin />
    <meta property="og:site_name" content="ax" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
    <link rel="apple-touch-icon" href={`${base}icon.png`} />
    <link rel="sitemap" type="application/xml" href={`${base}sitemap-index.xml`} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      :root {
        color-scheme: dark;
        --tn-bg:        #1e1e2e;
        --tn-bg-dark:   #11111b;
        --tn-bg-soft:   #181825;
        --tn-bg-hi:     #45475a;
        --tn-bg-card:   #313244;
        --tn-border:    #313244;
        --tn-border-hi: #45475a;
        --tn-fg:        #bac2de;
        --tn-fg-strong: #cdd6f4;
        --tn-fg-dark:   #a6adc8;
        --tn-comment:   #6c7086;
        --tn-blue:      #89b4fa;
        --tn-cyan:      #89dceb;
        --tn-purple:    #cba6f7;
        --tn-green:     #a6e3a1;
        --tn-yellow:    #f9e2af;
        --tn-orange:    #fab387;
        --tn-red:       #f38ba8;
        --tn-teal:      #94e2d5;
        --tn-shadow:    0 18px 44px rgb(0 0 0 / 34%);
        --tn-ring:      0 0 0 1px rgb(137 180 250 / 16%);
        --tn-mono:      'SF Mono', ui-monospace, 'JetBrains Mono', Menlo, Monaco, Consolas, monospace;
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', 'Helvetica Neue', Arial, sans-serif;
        min-width: 320px;
        background:
          linear-gradient(180deg, rgb(24 24 37 / 84%) 0, var(--tn-bg) 360px),
          var(--tn-bg);
        color: var(--tn-fg);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      code, pre, .mono {
        font-family: 'SF Mono', ui-monospace, Menlo, Monaco, Consolas, monospace;
      }

      /* fish-style shell syntax highlighting tokens */
      .sh-cmd  { color: var(--tn-blue); }
      .sh-arg  { color: var(--tn-fg-strong); }
      .sh-op   { color: var(--tn-teal); }
      .sh-flag { color: var(--tn-yellow); }

      a {
        color: var(--tn-blue);
        text-decoration: none;
        transition: color 0.2s ease;
      }
      a:hover {
        color: var(--tn-cyan);
      }

      ::selection {
        background: var(--tn-purple);
        color: var(--tn-bg);
      }

      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track { background: var(--tn-bg-dark); }
      ::-webkit-scrollbar-thumb {
        background: var(--tn-border);
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover { background: var(--tn-comment); }

      :focus-visible {
        outline: 2px solid var(--tn-cyan);
        outline-offset: 3px;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
